<h1>The Jobs EJS Application</h1>

<% if (errors.length > 0) { %>
  <% errors.forEach(err => { %>
    <div style="color:red;"><%= err %></div>
  <% }) %>
<% } %>

<% if (info.length > 0) { %>
  <% info.forEach(msg => { %>
    <div style="color:green;"><%= msg %></div>
  <% }) %>
<% } %>

<hr>

<nav>
  <% if (user) { %>
    Hello, <%= user.name %> |
    <form action="/sessions/logoff" method="POST" style="display:inline;">
      <button type="submit">Log Out</button>
    </form>
  <% } else { %>
    <a href="/sessions/logon">Log In</a> |
    <a href="/sessions/register">Register</a>
  <% } %>
</nav>

<hr>
